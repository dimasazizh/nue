<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <AssemblyName>Nue.Unified</AssemblyName>
    <Version>0.1.5</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefineConstants>$(DefineConstants);NUE_UNIFIED</DefineConstants>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Compass/*.cs;../HoverStats/*.cs;../HudTabs/*.cs;../InventoryAvatar/*.cs;../SearchCompare/*.cs;../SkillPortrait/*.cs"/>
    <Reference Include="MeitouClient;Meitou.Core;Meitou.Simulation;Meitou.Data;0Harmony">
      <HintPath>$(MeitouDir)/%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
